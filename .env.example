# Backend (Spring Boot đọc file .env ở gốc repo)
DB_URL=jdbc:mysql://localhost:3306/cinema_db?serverTimezone=Asia/Ho_Chi_Minh&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=change-me
